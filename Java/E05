package Start;

public class E05 {
	public static void main(String[] args) {
		Math m = new Math(); //객체 생성
		m.a = 100L;//a의 100
		m.b = 200L;//b의 200
		
//인스턴스 메서드 출력하는 것임.값을 설정해줘야함 인스턴스 생성 해서 사용
		System.out.println(m.add());
//클래스 메서드이며 인스턴스 생성이 필요가 없음.
		System.out.println(Math.add(200L,100L));
	}
}
class Math{
	long a,b; //인스턴스 변수
//인스턴스 메서드임. 즉 인스턴스 객체가 필요함.
	long add() { return a + b; }
	long subtract() { return a - b; }
//클래스 메서드임. 공유하고 있기에 위에 15라인은 상관 없음. 즉 단독으로 설정 가능
	static long add(long a,long b) { return a + b; }
	static long subtract(long a,long b) { return a - b; }
}
