package Start;
import java.util.Arrays;
public class D05 {
	public static void main(String[] args) {
		int[] code = { -4, -1, 3, 6, 11 };
		int[] arr = new int[10];
//i가 0부터 길이 10 미만까지 증가하고 랜덤으로 code길이 5개를 정수로 0~5미만
//그걸 tmp에 넣는데 tmp에 3이 왔다.그럼 code의 인덱스 3번째 6을 arr에 저장
		for (int i=0; i<arr.length; i++) {
			int tmp = (int)(Math.random() * code.length);
			arr[i] = code[tmp];
		}
//그냥 arr하면 배열의 주소값이 출력되어 배열의 toString으로 사용
		System.out.println("배열의 값은 : " + Arrays.toString(arr));
	}
}
