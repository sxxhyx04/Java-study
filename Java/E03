package Start;

public class E03 {
	public static void main(String[] args) { //main이 스택에 올라감.
//Data1클래스에 x값은 현재 0이고 주소값을 0x100이라고 함. 그것을 d1에 가리키게 함.
		Data1 d1 = new Data1();
//참조변수 d1이 가리키는 x값을 10으로 변경
		d1.x = 10; 
//이후 스택구조에서 출력 하고 사라짐
		System.out.println("main() : " + d1.x);
		
		change(d1); //메서드 호출
		System.out.println("After change(d1.x)");
		System.out.println("main() : " +d1.x);
	}
		static void change(Data1 d1) { //참조변수의 매개변수
			d1.x = 1000;//즉 쓰기가 됨
//출력하고 빠져도 참조변수로 쓰기까지 한 것이기에 main에도 1000으로 남음
			System.out.println("change() : x " + d1.x); 
		}
	}
class Data1{
	int x; 
}
