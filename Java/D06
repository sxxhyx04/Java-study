package Start;

public class D06 {
	public static void main(String[] args) {
		int[] numArr = new int[10]; //정수형 배열 10개 생성
		int[] counter = new int[10]; //정수형 배열 10개 생성
		
//반복문이고 i변수를 만들어 5번째 줄의 길이보다 작을 때 까지 i를 증가
//랜덤으로 생성하고 출력한다.
		for(int i=0; i<numArr.length; i++) { 
			numArr[i] = (int)(Math.random() * 10);
			System.out.println(numArr[i]);
		}
		System.out.println("------------");
//numArr와 같은 숫자가 나오면 counter 배열 인덱스 값을 1 증가.
		for(int i = 0; i < numArr.length; i++) {
			counter[numArr[i]]++;
		}
// counter 배열에 저장된 각 숫자를 출력함.
		for(int i = 0; i < numArr.length; i++) {
			System.out.println(i + "의 개수 : " + counter[i]);
		}
	}
}
