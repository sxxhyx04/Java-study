package Start;

public class F03 {

	public static void main(String[] args) {
		Child c = new Child();
		c.method();
	}
}

class Parent { int x = 10; } //super

class Child extends Parent{
//만일 int x가 선언이 안 되고 Parent에만 x가 있었더라면 x는 this, super 둘 다 가능함.
	int x = 20; //this
	
	void method() {
		System.out.println("x : " + x); //가까운 쪽 즉 클래스 안에 있는 x
		System.out.println("this.x : " + this.x); //this 
//super 즉 조상메서드를 구별 한다.
		System.out.println("super.x : " + super.x);
	}
}
