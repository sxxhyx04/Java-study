package Start;

public class D03 {
	public static void main(String[] args) {
		int[] score = { 90, 80, 90, 30, 100, 50, 90 };
		//배열의 값들을 생성
		int max = score[0]; //최대값은 현재 90
		int min = score[0]; //최소값은 현재 90
		
//i가 1부터 배열의 길이보다 적을 때 까지 증가하며, 만약 
//i가 max즉 90보다 크면 큰 값을 max에 반환해주고 그렇지 않고 작으면 min에 반환
		for(int i = 1; i < score.length;i++) {
			if(score[i] > max) {
				max = score[i];
			}else if (score[i] < min) {
				min = score[i];
			}
		}
		System.out.println("최대값 : " + max);
		System.out.println("최소값 : " + min);
	}
}
