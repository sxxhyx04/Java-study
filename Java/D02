package Start;

public class D02 {
	public static void main(String[] args) {
		//변수 선언
		int sum = 0;
		float average = 0f;
		
		int[] score = { 100,90,100,100,90 }; //배열 값 생성
		
//반복문으로 0부터 배열의 길이보다 작을 때 까지 증가하고
//선언한 변수의 sum + score[i]를 sum에 반환함.
		for(int i = 0; i < score.length; i++) {
			sum += score[i];
		}
//평균을 sum / 배열의 길이 즉 5로 나누고 소숫점으로 반환
		average = sum / (float)(score.length);
		
		System.out.println("총점 : " + sum);
		System.out.println("평균 : " + average);
	}
}
